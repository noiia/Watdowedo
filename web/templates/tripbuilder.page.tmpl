<!DOCTYPE html>
<html lang="eng">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="stylesheet" type="text/css" href="../static/css/output.css" />
		<title>Watdowedo - Home</title>
	</head>
	<body>
		<div class="bg-primary">
			<h1 class="text-3xl p-8">Watdowedo</h1>
		</div>
		<form>
			<div class="mx-auto">
				<div class="mx-auto my-10">
					Your basement :
					<input
						type="text"
						placeholder="Paris, New york, ..."
						class="mx-auto input input-primary input-bordered w-full"
					/>
				</div>

				<div class="grid grid-cols-3 gap-4">
					<fieldset>
						<input
							type="radio"
							class="radio radio-primary p-6"
							id="sm-walker"
							name="walking-level"
						/><label for="sm-walker">Small walker (1-5 km / day)</label
						><input
							type="radio"
							class="radio radio-primary p-6"
							id="walker"
							name="walking-level"
						/>
						<label for="walker">Walker (+5 km / day)</label>
						<input
							type="radio"
							class="radio radio-primary p-6"
							id="gd-walker"
							name="walking-level"
						/><label for="gd-walker">Good walker (+10 km / day)</label>
					</fieldset>
				</div>
				<div>
					<input type="checkbox" class="toggle toggle-primary" />Invalide
				</div>
				<div><button type="submit" class="btn btn-primary"/> Apply</button></div>
			</div>
		</form>
	</body>
</html>
